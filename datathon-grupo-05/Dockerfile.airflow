FROM apache/airflow:2.10.0

# build-essential necessário para compilar extensões C do numpy/pandas/sklearn
USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     build-essential \
     python3-venv \
  && apt-get autoremove -yqq --purge \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

USER airflow

ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_RETRIES=5

WORKDIR /ml_project

COPY requirements-airflow.txt ./

# Cria o venv no path exato que as tasks das DAGs usam (/ml_project/.venv/bin/python)
RUN python3 -m venv /ml_project/.venv

# CPU-only torch: evita ~3GB de pacotes CUDA desnecessários no orquestrador
# O Airflow só precisa executar o script de treino, não precisa de GPU
RUN /ml_project/.venv/bin/pip install --no-cache-dir --upgrade pip && \
    /ml_project/.venv/bin/pip install --no-cache-dir \
      torch --index-url https://download.pytorch.org/whl/cpu

# Demais dependências do pipeline (sem stack LLM/agente/serving)
RUN /ml_project/.venv/bin/pip install --no-cache-dir -r requirements-airflow.txt

WORKDIR /opt/airflow
